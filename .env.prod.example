# nonebot2
host = 0.0.0.0  # 配置 NoneBot 监听的 IP/主机名
port = 9223  # 配置 NoneBot 监听的端口（开发 worktree，避免占用生产 9222）

debug = true  # 开启 debug 模式 **请勿在生产环境开启**

# Milky adapter 需要 HTTPClient + WebSocketClient；FastAPI 只提供 HTTP server，不提供这两个 mixin
DRIVER=~fastapi+~httpx+~websockets

superusers = []  # 配置 NoneBot 超级用户
nickname = []  # 配置机器人的昵称

command_start = ["/", ""]  # 配置命令起始字符
command_sep = ["."]  # 配置命令分割字符



# go-cqhttp access_token
access_token = ""
# go-cqhttp web_ui port
admin_port=9999

# 全局境外服务代理：steam/x/telegram 统一走此代理，未配置则直连
OUTSIDE_PROXY=

# Telegram（token 格式示例：123456:ABC...）
telegram_bots=[]
# 留空时自动使用 OUTSIDE_PROXY；单独设置可覆盖
telegram_proxy=""

# Milky QQNT 协议端（正向 WebSocket + HTTP API）
milky_clients=[]
# milky_clients=[{"host":"127.0.0.1","port":3000,"access_token":"","secure":false}]
# Webhook 反向模式二选一：milky_webhook={"host":"127.0.0.1","port":3000}

# 需要启用的模块
modules=["information","interactive","develop","tools","entertainment","ai"]
# 运行时数据存放处
data=data
# 回复"在？"的话
zai=はい！私はいつも貴方の側にいますよ！
# chrome user files
chrome_path=./chrome-files
# apscheduler
APSCHEDULER_AUTOSTART=true
APSCHEDULER_CONFIG={"apscheduler.timezone": "Asia/Shanghai","apscheduler.job_defaults.misfire_grace_time":"60","apscheduler.job_defaults.coalesce": "true"}

# ---- AI（aichat / ai_admin）----
# 字段由 hoshino/ai/config.py 的挂载机制注入 HoshinoConfig（env 名 AI_*，见 AI_*）
# 默认 provider id（须已在 DB 配置，`ai setup` 新增；运行时可用 `ai provider default` 覆盖到 DB）
AI_DEFAULT_PROVIDER=opencode-go
# 默认人格；留空使用内置默认人格
# AI_SYSTEM_PROMPT=
# 代理（http/https/socks）
AI_PROXY=http://127.0.0.1:7890
# 工具抓取请求（web_fetch/browser_use/image_view/web_search）走代理；默认 false 直连
AI_TOOL_USE_PROXY=true
# 历史长度限制（轮/条）
AI_MAX_HISTORY_MESSAGES=40
# Markdown 渲染（超时秒/主题 light|dark/字体）
# AI_RENDER_TIMEOUT_SECONDS=30.0
# AI_RENDER_THEME=light
# AI_RENDER_FONT=Inter
# 联网搜索（web_search 工具，provider 原生）/ 工具重试预算 / web_fetch 证书校验
# AI_TOOL_MAX_RETRIES=3
# AI_WEB_FETCH_VERIFY_SSL=false
# chat 护栏：单轮墙钟秒数 / 单轮模型请求上限
# AI_CHAT_RUN_TIMEOUT_SECONDS=180.0
# AI_CHAT_MAX_REQUESTS=12
# task 审批模式 auto|always|never
# AI_TASK_APPROVAL_MODE=auto
